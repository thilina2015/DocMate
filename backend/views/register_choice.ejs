<!doctype html>
<html>
<head><%- include("partials/head", { title: "Register - DocMate" }) %></head>
<body>
  <%- include("partials/navbar") %>

  <div class="container mt-4">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="dm-card p-4 p-md-5">
          <h2 class="fw-extrabold mb-1">Create your account</h2>
          <div class="small-muted">Choose your role to continue.</div>

          <div class="row g-3 mt-4">
            <div class="col-md-6">
              <div class="dm-card p-4 h-100">
                <div class="fw-bold fs-5">Patient</div>
                <div class="small-muted mt-1">View and edit your personal profile and see doctor updates.</div>
                <a class="btn btn-primary w-100 mt-3" href="/register/patient">Register as Patient</a>
              </div>
            </div>
            <div class="col-md-6">
              <div class="dm-card p-4 h-100">
                <div class="fw-bold fs-5">Doctor</div>
                <div class="small-muted mt-1">Search patients, add medical updates and reports. Needs admin approval.</div>
                <a class="btn btn-outline-primary w-100 mt-3" href="/register/doctor">Register as Doctor</a>
              </div>
            </div>
          </div>

          <% if (flash) { %>
            <div class="alert alert-<%= flash.type %> mt-3 dm-soft"><%= flash.msg %></div>
          <% } %>

        </div>
      </div>
    </div>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
