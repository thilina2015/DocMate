<!doctype html>
<html>
<head><%- include("partials/head", { title: "Patient Registration - DocMate" }) %></head>
<body>
  <%- include("partials/navbar") %>

  <div class="container mt-4">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="dm-card p-4 p-md-5">
          <h2 class="fw-extrabold mb-1">Patient Registration</h2>
          <div class="small-muted">You can edit these details later.</div>

          <% if (flash) { %>
            <div class="alert alert-<%= flash.type %> mt-3 dm-soft"><%= flash.msg %></div>
          <% } %>

          <form method="POST" action="/register/patient" class="mt-4">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Full Name</label>
                <input class="form-control" name="name" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Date of Birth</label>
                <input class="form-control" type="date" name="dob">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">Email</label>
                <input class="form-control" type="email" name="email" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Password</label>
                <input class="form-control" type="password" name="password" required>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">Blood Group</label>
                <input class="form-control" name="blood_group" placeholder="e.g. O+">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Weight (kg)</label>
                <input class="form-control" name="weight" type="number" step="0.1">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Height (cm)</label>
                <input class="form-control" name="height" type="number" step="0.1">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">Past Injuries</label>
                <textarea class="form-control" name="past_injuries" rows="3"></textarea>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Past Illness</label>
                <textarea class="form-control" name="past_illness" rows="3"></textarea>
              </div>
            </div>

            <button class="btn btn-primary btn-lg w-100 mt-4" type="submit">Create Patient Account</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
