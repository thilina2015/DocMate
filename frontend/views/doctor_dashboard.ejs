<!doctype html>
<html>
<head><%- include("partials/head", { title: "Doctor Panel - DocMate" }) %></head>
<body>
  <%- include("partials/navbar") %>

  <div class="container mt-4">
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> dm-soft"><%= flash.msg %></div>
    <% } %>

    <div class="row g-3">
      <div class="col-lg-4">
        <div class="dm-card p-4">
          <div class="d-flex align-items-center gap-3">
            <img alt="doctor" class="dm-soft" style="width:54px;height:54px;object-fit:cover"
              src="https://images.unsplash.com/photo-1537368910025-700350fe46c7?auto=format&fit=crop&w=160&q=80">
            <div>
              <div class="fw-extrabold fs-5"><%= doctor?.name || me.name %></div>
              <div class="small-muted"><%= me.email %></div>
            </div>
          </div>

          <hr class="hr-soft my-3">

          <div class="small-muted">Doctor ID</div>
          <div class="fw-semibold"><%= doctor?.doctor_id || "-" %></div>

          <div class="mt-2">
            <div class="small-muted">Hospital</div>
            <div class="fw-semibold"><%= doctor?.hospital || "-" %></div>
          </div>

          <div class="mt-2">
            <div class="small-muted">Specialization</div>
            <div class="fw-semibold"><%= doctor?.specialization || "-" %></div>
          </div>

          <div class="mt-2">
            <div class="small-muted">Service Duration</div>
            <div class="fw-semibold"><%= doctor?.service_duration || "-" %></div>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="dm-card p-4">
          <div class="fw-extrabold fs-4">Search Patients</div>
          <div class="small-muted">Search by Patient ID or name.</div>

          <form class="d-flex gap-2 mt-3" method="GET" action="/doctor/search">
            <input class="form-control" name="q" value="<%= q %>" placeholder="e.g. 12 or Nimal">
            <button class="btn btn-primary" type="submit">Search</button>
          </form>

          <div class="mt-4">
            <% if (results === null) { %>
              <div class="alert alert-light dm-soft mb-0">No search yet.</div>
            <% } else if (!results.length) { %>
              <div class="alert alert-light dm-soft mb-0">No patients found.</div>
            <% } else { %>
              <div class="table-responsive mt-2">
                <table class="table align-middle">
                  <thead>
                    <tr>
                      <th>Patient ID</th>
                      <th>Name</th>
                      <th>Email</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% results.forEach(r => { %>
                      <tr>
                        <td class="fw-semibold">#<%= r.id %></td>
                        <td><%= r.name %></td>
                        <td class="small-muted"><%= r.email %></td>
                        <td class="text-end">
                          <a class="btn btn-outline-primary btn-sm" href="/doctor/patient/<%= r.id %>">View Profile</a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>

        </div>
      </div>
    </div>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
