<!doctype html>
<html>
<head><%- include("partials/head", { title: "My Profile - DocMate" }) %></head>
<body>
  <%- include("partials/navbar") %>

  <div class="container mt-4">
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> dm-soft"><%= flash.msg %></div>
    <% } %>

    <div class="row g-3">
      <div class="col-lg-4">
        <div class="dm-card p-4">
          <div class="d-flex align-items-center gap-3">
            <img alt="avatar" class="dm-soft" style="width:54px;height:54px;object-fit:cover"
              src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=160&q=80">
            <div>
              <div class="fw-extrabold fs-5"><%= profile.name %></div>
              <div class="small-muted"><%= profile.email %></div>
            </div>
          </div>

          <hr class="hr-soft my-3">

          <div class="small-muted">Patient ID</div>
          <div class="fw-bold">#<%= profile.id %></div>

          <div class="mt-3">
            <div class="small-muted">DOB</div>
            <div class="fw-semibold"><%= profile.dob || "-" %></div>
          </div>

          <div class="mt-2">
            <div class="small-muted">Blood Group</div>
            <div class="fw-semibold"><%= profile.blood_group || "-" %></div>
          </div>

          <div class="row mt-3">
            <div class="col-6">
              <div class="small-muted">Weight</div>
              <div class="fw-semibold"><%= profile.weight || "-" %></div>
            </div>
            <div class="col-6">
              <div class="small-muted">Height</div>
              <div class="fw-semibold"><%= profile.height || "-" %></div>
            </div>
          </div>

          <a class="btn btn-primary w-100 mt-4" href="/patient/profile/edit">Edit Personal Details</a>
        </div>

        <div class="dm-card p-4 mt-3">
          <div class="fw-bold">Past Injuries</div>
          <div class="small-muted mt-1"><%= profile.past_injuries || "No data" %></div>
          <hr class="hr-soft my-3">
          <div class="fw-bold">Past Illness</div>
          <div class="small-muted mt-1"><%= profile.past_illness || "No data" %></div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="dm-card p-4">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
              <div class="fw-extrabold fs-4">Doctor Updates</div>
              <div class="small-muted">Latest updates appear first.</div>
            </div>
            <span class="badge badge-soft rounded-pill px-3 py-2">Reports Included</span>
          </div>

          <div class="mt-3 d-flex flex-column gap-3">
            <% if (!updates.length) { %>
              <div class="alert alert-light dm-soft mb-0">No updates yet.</div>
            <% } %>

            <% updates.forEach(u => { %>
              <div class="dm-soft bg-white border p-3">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                  <div>
                    <div class="fw-bold"><%= u.title %></div>
                    <div class="small-muted">By Dr. <%= u.doctor_name %> • <%= u.created_at %></div>
                  </div>
                  <% if (u.report_file) { %>
                    <a class="btn btn-outline-primary btn-sm" href="<%= u.report_file %>" target="_blank">View Report</a>
                  <% } %>
                </div>

                <% if (u.illness) { %>
                  <div class="mt-2"><span class="fw-semibold">Illness:</span> <span class="small-muted"><%= u.illness %></span></div>
                <% } %>
                <% if (u.medicines) { %>
                  <div class="mt-1"><span class="fw-semibold">Medicines:</span> <span class="small-muted"><%= u.medicines %></span></div>
                <% } %>
                <% if (u.notes) { %>
                  <div class="mt-1"><span class="fw-semibold">Notes:</span> <span class="small-muted"><%= u.notes %></span></div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

    </div>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
