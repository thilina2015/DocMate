<!doctype html>
<html>
<head><%- include("partials/head", { title: "Doctor Registration - DocMate" }) %></head>
<body>
  <%- include("partials/navbar") %>

  <div class="container mt-4">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="dm-card p-4 p-md-5">
          <h2 class="fw-extrabold mb-1">Doctor Registration</h2>
          <div class="small-muted">Submit details for admin approval.</div>

          <% if (flash) { %>
            <div class="alert alert-<%= flash.type %> mt-3 dm-soft"><%= flash.msg %></div>
          <% } %>

          <form method="POST" action="/register/doctor" class="mt-4">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Full Name</label>
                <input class="form-control" name="name" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Email</label>
                <input class="form-control" type="email" name="email" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">Password</label>
                <input class="form-control" type="password" name="password" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Doctor ID</label>
                <input class="form-control" name="doctor_id" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">Hospital</label>
                <input class="form-control" name="hospital" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Specialization</label>
                <input class="form-control" name="specialization" required>
              </div>

              <div class="col-12">
                <label class="form-label fw-semibold">Service Duration</label>
                <input class="form-control" name="service_duration" placeholder="e.g. 5 years" required>
              </div>
            </div>

            <button class="btn btn-primary btn-lg w-100 mt-4" type="submit">Submit for Approval</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
