<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Panel - DocMate</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Icons (optional but nice) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    :root{
      --bg:#f6f7fb;
      --card:#ffffff;
      --muted:#6c757d;
      --shadow:0 14px 40px rgba(17, 24, 39, .08);
      --radius:18px;
    }
    body{ background:var(--bg); }
    .dm-card{
      background:var(--card);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      border: 1px solid rgba(0,0,0,.06);
    }
    .small-muted{ color:var(--muted); font-size:.92rem; }
    .fw-extrabold{ font-weight:800; }
    .dm-pill{
      border-radius: 999px;
      padding: .35rem .75rem;
      border: 1px solid rgba(0,0,0,.08);
      background: rgba(255,255,255,.7);
      backdrop-filter: blur(6px);
    }
    .table thead th{
      font-size: .88rem;
      color: #475569;
      border-bottom: 1px solid rgba(0,0,0,.08);
    }
    .table td{ vertical-align: middle; }
    .dm-badge{
      border-radius: 999px;
      font-weight: 600;
      padding: .35rem .6rem;
      font-size: .82rem;
    }
    .dm-status-approved{ background: rgba(25,135,84,.12); color:#198754; }
    .dm-status-pending{ background: rgba(255,193,7,.18); color:#b58100; }
    .dm-status-rejected{ background: rgba(220,53,69,.12); color:#dc3545; }
    .dm-toast{
      position: fixed;
      right: 16px;
      bottom: 16px;
      z-index: 9999;
      min-width: 260px;
    }
    .dm-topbar{
      background: rgba(255,255,255,.75);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(0,0,0,.06);
    }
    .dm-logo{
      width: 36px; height: 36px;
      display:inline-grid; place-items:center;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(13,110,253,.18), rgba(111,66,193,.14));
      border: 1px solid rgba(13,110,253,.25);
    }
    .dm-cta{
      border-radius: 12px;
    }
    .dm-input{
      border-radius: 14px;
    }
  </style>
</head>

<body>

<!-- Navbar -->
<nav class="navbar dm-topbar sticky-top">
  <div class="container py-2">
    <div class="d-flex align-items-center gap-2">
      <span class="dm-logo"><i class="bi bi-shield-check text-primary"></i></span>
      <div>
        <div class="fw-bold lh-1">DocMate</div>
        <div class="small-muted lh-1">Admin Panel</div>
      </div>
    </div>

    <div class="d-flex align-items-center gap-2">
      <span class="dm-pill small-muted"><i class="bi bi-person-gear me-1"></i>Admin</span>
      <button class="btn btn-outline-primary dm-cta btn-sm" type="button">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
      </button>
    </div>
  </div>
</nav>

<div class="container my-4">

  <!-- Header -->
  <div class="dm-card p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <div class="fw-extrabold fs-4">Doctor Approvals</div>
        <div class="small-muted">Approve doctors to allow login and patient access.</div>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <div class="input-group">
          <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
          <input id="searchInput" type="text" class="form-control dm-input" placeholder="Search by name, email, hospital...">
        </div>

        <div class="btn-group">
          <button class="btn btn-outline-secondary" data-filter="all" type="button">All</button>
          <button class="btn btn-outline-secondary" data-filter="pending" type="button">Pending</button>
          <button class="btn btn-outline-secondary" data-filter="approved" type="button">Approved</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="dm-card p-4">
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="doctorTable">
        <thead>
          <tr>
            <th style="min-width:80px;">ID</th>
            <th style="min-width:170px;">Name</th>
            <th style="min-width:220px;">Email</th>
            <th style="min-width:130px;">Doctor ID</th>
            <th style="min-width:160px;">Hospital</th>
            <th style="min-width:170px;">Specialization</th>
            <th style="min-width:120px;">Service</th>
            <th style="min-width:120px;">Status</th>
            <th style="min-width:160px;" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody id="doctorTbody">
          <!-- Row 1 -->
          <tr data-status="pending">
            <td class="fw-semibold">#1</td>
            <td class="fw-semibold">Dr. Amal Perera</td>
            <td class="small-muted">amal@example.com</td>
            <td>SL-1022</td>
            <td>Asiri Hospital</td>
            <td>Cardiology</td>
            <td>5 years</td>
            <td>
              <span class="dm-badge dm-status-pending" data-badge>Pending</span>
            </td>
            <td class="text-end">
              <button class="btn btn-primary btn-sm me-1" data-action="approve" type="button">
                <i class="bi bi-check2-circle me-1"></i>Approve
              </button>
              <button class="btn btn-outline-danger btn-sm" data-action="reject" type="button">
                <i class="bi bi-x-circle me-1"></i>Reject
              </button>
            </td>
          </tr>

          <!-- Row 2 -->
          <tr data-status="approved">
            <td class="fw-semibold">#2</td>
            <td class="fw-semibold">Dr. Nethmi Silva</td>
            <td class="small-muted">nethmi@example.com</td>
            <td>SL-2044</td>
            <td>Lanka Hospitals</td>
            <td>Dermatology</td>
            <td>2 years</td>
            <td>
              <span class="dm-badge dm-status-approved" data-badge>Approved</span>
            </td>
            <td class="text-end">
              <span class="small-muted">—</span>
            </td>
          </tr>

          <!-- Row 3 -->
          <tr data-status="pending">
            <td class="fw-semibold">#3</td>
            <td class="fw-semibold">Dr. Isuru Jayasena</td>
            <td class="small-muted">isuru@example.com</td>
            <td>SL-3091</td>
            <td>NHSL</td>
            <td>Neurology</td>
            <td>1 year</td>
            <td>
              <span class="dm-badge dm-status-pending" data-badge>Pending</span>
            </td>
            <td class="text-end">
              <button class="btn btn-primary btn-sm me-1" data-action="approve" type="button">
                <i class="bi bi-check2-circle me-1"></i>Approve
              </button>
              <button class="btn btn-outline-danger btn-sm" data-action="reject" type="button">
                <i class="bi bi-x-circle me-1"></i>Reject
              </button>
            </td>
          </tr>

        </tbody>
      </table>
    </div>

    <div id="emptyState" class="alert alert-light mt-3 mb-0 d-none" style="border-radius:14px;">
      No doctor registrations found.
    </div>
  </div>
</div>

<!-- Toast -->
<div class="dm-toast">
  <div id="toastBox" class="alert alert-success d-none mb-0" style="border-radius:14px;"></div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  const tbody = document.getElementById("doctorTbody");
  const searchInput = document.getElementById("searchInput");
  const emptyState = document.getElementById("emptyState");
  const toastBox = document.getElementById("toastBox");

  let currentFilter = "all";

  function showToast(msg, type="success"){
    toastBox.className = `alert alert-${type} mb-0`;
    toastBox.style.borderRadius = "14px";
    toastBox.textContent = msg;
    toastBox.classList.remove("d-none");
    setTimeout(() => toastBox.classList.add("d-none"), 2200);
  }

  function setRowStatus(row, status){
    row.dataset.status = status;

    const badge = row.querySelector("[data-badge]");
    badge.classList.remove("dm-status-approved","dm-status-pending","dm-status-rejected");

    if(status === "approved"){
      badge.textContent = "Approved";
      badge.classList.add("dm-status-approved");
      // remove buttons
      row.querySelector("td:last-child").innerHTML = `<span class="small-muted">—</span>`;
    }

    if(status === "pending"){
      badge.textContent = "Pending";
      badge.classList.add("dm-status-pending");
    }

    if(status === "rejected"){
      badge.textContent = "Rejected";
      badge.classList.add("dm-status-rejected");
      row.querySelector("td:last-child").innerHTML = `<span class="small-muted">—</span>`;
    }
  }

  function applySearchAndFilter(){
    const q = searchInput.value.trim().toLowerCase();
    const rows = Array.from(tbody.querySelectorAll("tr"));

    let visibleCount = 0;

    rows.forEach(row => {
      const text = row.textContent.toLowerCase();
      const matchSearch = text.includes(q);

      const status = row.dataset.status;
      const matchFilter =
        currentFilter === "all" ||
        (currentFilter === "pending" && status === "pending") ||
        (currentFilter === "approved" && status === "approved");

      const show = matchSearch && matchFilter;
      row.classList.toggle("d-none", !show);
      if(show) visibleCount++;
    });

    emptyState.classList.toggle("d-none", visibleCount !== 0);
  }

  // Approve/Reject actions
  tbody.addEventListener("click", (e) => {
    const btn = e.target.closest("button");
    if(!btn) return;

    const action = btn.dataset.action;
    const row = btn.closest("tr");
    const id = row.querySelector("td").textContent.trim();

    if(action === "approve"){
      setRowStatus(row, "approved");
      showToast(`${id} approved.`, "success");
    }

    if(action === "reject"){
      setRowStatus(row, "rejected");
      showToast(`${id} rejected.`, "warning");
    }

    applySearchAndFilter();
  });

  // Search
  searchInput.addEventListener("input", applySearchAndFilter);

  // Filter buttons
  document.querySelectorAll("[data-filter]").forEach(btn => {
    btn.addEventListener("click", () => {
      currentFilter = btn.dataset.filter;

      // active style
      document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("btn-secondary"));
      document.querySelectorAll("[data-filter]").forEach(b => b.classList.add("btn-outline-secondary"));
      btn.classList.remove("btn-outline-secondary");
      btn.classList.add("btn-secondary");

      applySearchAndFilter();
    });
  });

  // default active filter = All
  document.querySelector('[data-filter="all"]').classList.remove("btn-outline-secondary");
  document.querySelector('[data-filter="all"]').classList.add("btn-secondary");

  applySearchAndFilter();
</script>

</body>
</html>