<!doctype html>
<html>
<head><%- include("partials/head", { title: "Login - DocMate" }) %></head>
<body>
  <%- include("partials/navbar") %>

  <div class="container mt-4">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="dm-card p-4 p-md-5">
          <h2 class="fw-extrabold mb-1">Login</h2>
          <div class="small-muted">Use your email and password.</div>

          <% if (flash) { %>
            <div class="alert alert-<%= flash.type %> mt-3 dm-soft"><%= flash.msg %></div>
          <% } %>

          <form method="POST" action="/login" class="mt-4">
            <div class="mb-3">
              <label class="form-label fw-semibold">Email</label>
              <input class="form-control" type="email" name="email" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Password</label>
              <input class="form-control" type="password" name="password" required>
            </div>
            <button class="btn btn-primary w-100 btn-lg" type="submit">Login</button>
          </form>

          <div class="small-muted mt-3">
            Admin login: <b>admin@docmate.local</b> / <b>admin123</b>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
